<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" type="text/css" href="/styles/reset.css">
    <link rel="stylesheet" type="text/css" href="/styles/styles.css">
    <script src="/scripts/sidebarInteractions.js" defer></script>
</head>
<body>
    <div class="wrapper">
        <%- include('partials/header') %>
        <%- include('partials/sidebar') %>
        <main>
            <h1><%= title %> <%= type %></h1>
            <form method="POST" action="/inventory/<%= type.toLowerCase() %>">
                <div>
                    <div>
                        <div>
                            <label for="item">Item:</label>
                            <select name="item_id" id="item">
                                <option value="">Select item</option>
                                <% if (locals.items) { items.forEach(item => { %>
                                    <option
                                        value=<%= item.id %>
                                        <% if (locals.invMatch != undefined && locals.invMatch.item_id == item.id) {%> selected <%}%>
                                    ><%= item.name %></option>
                                <% })} %>
                            </select>
                        </div>
                        <% if (locals.errors && errors.item_id) {%>
                            <p class="error-msg"><%= errors.item_id.msg %></p>
                        <%}%>
                    </div>
                    <div>
                        <div>
                            <label for="quantity">Quantity:</label>
                            <input
                                id="quantity"
                                name="quantity"
                                <%  let quantHolder = (locals.invMatch != undefined) ? invMatch.quantity : 1 %>
                                value=<%= quantHolder %>
                            >
                        </div>
                        <% if (locals.errors && errors.quantity) {%>
                            <p class="error-msg"><%= errors.quantity.msg %></p>
                        <%}%>
                    </div>
                    <div>
                        <div>
                            <label for="person">Owner:</label>
                            <select name="person_id" id="person">
                                 <option value="">Select person</option>
                                <% if (locals.people) { people.forEach(person => { %>
                                    <% let selectVal = (locals.invMatch != undefined && locals.invMatch.person_id == person.id) ? 'selected' : ''%>
                                    <option
                                        value=<%= person.id %>
                                        <% if (locals.invMatch != undefined && locals.invMatch.person_id== person.id) {%> selected <%}%> >
                                        <%= person.name %>
                                    </option>
                                <% })} %>
                            </select>
                        </div>
                        <% if (locals.errors && errors.person_id) {%>
                            <p class="error-msg"><%= errors.person_id.msg %></p>
                        <%}%>
                    </div>
                </div>
                <% if (locals.invMatch) {%>
                    <input hidden name="id" value=<%= invMatch.id %>>
                <%}%>
                <button type="submit">submit</button>
            </form>
        </main>
    </div>
</body>
</html>