<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
</head>
<body>
    <%- include('partials/header') %>
    <%- include('partials/sidebar') %>

    <% let sTitle = title.toLowerCase() %>
    <% let namePlaceholder = locals.name ? locals.name : '' %>
    <% let descPlaceholder = locals.description ? description : '' %>

    <main>
        <h1><%= title %> <%= type %></h1>
        <form method="POST" action="/<%= sTitle %>/<%= type.toLowerCase() %>">
            <div>
                <label for="name">Name:</label>
                <input id="name" name="name" value='<%= namePlaceholder %>'>

                <% if (sTitle != 'person') { %>
                    <label for="description">Description:</label>
                    <input id="description" name="description" value='<%= descPlaceholder %>'>
                <%}%>
                
                <% if (sTitle == 'item' && locals.categories && locals.categories.length > 0) {%> 
                    <p>Category:</p>
                    <% categories.forEach(category => { %>
                        <input 
                            id="category-<%= category.id%>" 
                            type="checkbox" 
                            name="category" 
                            value="<%=category.id%>"
                            <% if (type.toLowerCase() == 'update' && itemCategories.includes(category.id)) { %>
                                checked
                            <%}%>
                        >
                        <label for="category-<%= category.id%>"><%= category.name %></label>
                    <%})%>
                <%}%>

                <% if (type.toLowerCase() == 'update') {%>
                    <input value="<%=id%>" type="hidden" name="id">
                <% } %>
            </div>
            <button type="submit">submit</button>
        </form>
    </main>
</body>
</html>