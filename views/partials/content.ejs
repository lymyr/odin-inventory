<% // WHAT IS THIS AMALGAMATION T-T %>

<% if (locals.dataList.length > 0) { %>
    <table>
        <tr>
            <% Object.keys(dataList[0]).forEach(colName => { %>
                <th><%= colName %></th>
            <%})%>
        </tr>
        <% dataList.forEach(data => { %>
            <tr>
                <% Object.values(data).forEach(cell => { %>
                    <td>
                        <% if (Array.isArray(cell)) { %>
                            <% cell.forEach(category => { %>
                            <div><%= category %></div>
                        <%})} else {%>
                            <%= cell %>
                        <%}%>
                    </td>
                <%})%>
                <td>
                    <form method="POST" action="/<%= title.toLowerCase() %>/<%= data.id %>">
                        <input value='delete' hidden>
                        <a><button>delete</button></a>
                    </form>
                    
                </td>
                <td>
                    <a href="/update/<%= data.id %>"><button>update</button></a>
                </td>
            </tr>
        <%})%>

    </table>
<%}%>