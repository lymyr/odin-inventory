<% // WHAT IS THIS AMALGAMATION T-T %>

<% if (locals.dataList.length > 0) { %>
    <table>
        <thead>
            <tr>
                <% Object.keys(dataList[0]).forEach(colName => { %>
                    <th><%= colName %></th>
                <%})%>
                <th colspan="2">actions</th>
            </tr>
        </thead>
        <tbody>
            <% dataList.forEach(data => { %>
                <tr>
                    <% Object.values(data).forEach((cell, i) => { %>
                        <td class="<%= Object.keys(dataList[0])[i] %>">
                            <div>
                                <% if (Array.isArray(cell) && cell[0] !== null) { %>
                                    <% cell.forEach(category => { %>
                                    <div><%= category %></div>
                                <%})} else {%>
                                    <%= cell %>
                                <%}%>
                            </div>
                        </td>
                    <%})%>
                    <td>
                        <form method="POST" action="/<%= title.toLowerCase() %>/delete">
                            <input name='id' value=<%= data.id %> hidden>
                            <button type="button" command="show-modal" commandFor="delete-dialog-<%= data.id %>">delete</button>
                            <dialog id="delete-dialog-<%= data.id %>">
                                <p>
                                    Are you sure you want to delete
                                    <% if (title.toLowerCase() == 'inventory') {%>
                                        <span><%= data.item %></span> item of <span><%= data.owner %></span>?
                                    <%} else {%>
                                        <span><%= data.name %></span>
                                    <%}%>
                                </p>
                                <div>
                                    <button type="button" commandFor="delete-dialog-<%= data.id %>" command="close" class="cancel-dialog-btn">cancel</button>
                                    <button type="submit">yes</button>
                                </div>
                            </dialog>
                        </form>
            
                    </td>
                    <td>
                        <a href="/<%= title.toLowerCase() %>/update/<%= data.id %>"><button>update</button></a>
                    </td>
                </tr>
            <%})%>
        </tbody>

    </table>
<%}%>